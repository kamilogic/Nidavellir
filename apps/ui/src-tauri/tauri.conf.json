{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nidavellir",
  "version": "0.1.0",
  "identifier": "com.nidavellir.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nidavellir",
        "width": 1180,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/nidavellir-service"],
    "resources": [
      "resources/third_party/pawnio/",
      "resources/pawnio-modules/"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}
